{
  "expo": {
    "name": "TVsham",
    "slug": "tvsham",
    "version": "0.1.0",
    "scheme": "tvsham",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0b0b10",
    "ios": {
      "bundleIdentifier": "com.platteration.tvsham",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "TVsham points the camera at a TV or laptop screen to identify what is playing.",
        "NSMicrophoneUsageDescription": "TVsham records a few seconds of audio so dialogue can help identify the show.",
        "NSPhotoLibraryUsageDescription": "TVsham reads a screen recording you pick so it can identify the video in it.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.platteration.tvsham",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0b10"
      },
      "userInterfaceStyle": "automatic"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "TVsham points the camera at a TV or laptop screen to identify what is playing.",
          "microphonePermission": "TVsham records a few seconds of audio so dialogue can help identify the show.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TVsham reads a screen recording you pick so it can identify the video in it."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0b0b10"
        }
      ],
      "./plugins/withLocalNetworkCleartext"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "serverUrl": ""
    },
    "icon": "./assets/icon.png"
  }
}
