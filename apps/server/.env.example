# Required. Get one at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for recognition. Default: claude-opus-5
# CLAUDE_MODEL=claude-opus-5

# Port to listen on
PORT=8787

# Interface to listen on. Loopback by default: out of the box this server has no
# token and no daily cap, and a laptop joins networks you do not control. Set
# 0.0.0.0 to let a phone on your LAN reach it, after setting APP_TOKEN.
# HOST=0.0.0.0

# Optional shared secret. When set, the app must send "Authorization: Bearer <token>".
# It is the only thing between the internet and your Claude bill, so generate it
# rather than inventing one:  openssl rand -hex 32
# APP_TOKEN=

# Clips analysed in parallel across all sessions; the rest wait. Default 3.
# MAX_CONCURRENT=3

# Uploads that may be in memory at once, counted before the body is read;
# further ones get a 503 with Retry-After. Each costs about twice the clip size
# while it is in flight. Default: twice MAX_CONCURRENT.
# MAX_UPLOADS_IN_FLIGHT=6

# ...of which one caller may hold this many. A body is only released once all of
# it has arrived, so without a share per caller a few stalled sockets from one
# address answer everyone else with a 503. Default: half MAX_UPLOADS_IN_FLIGHT.
# MAX_UPLOADS_PER_CALLER=3

# How long the server waits for a whole request, and for its headers. Node's own
# defaults are 5 minutes and 1 minute, which is how long a stalled upload holds
# its slot; how many stalled uploads may hold one at once is what the two caps
# above are for. The default here is the app's own 180 s upload deadline plus
# node's 30 s expiry check and slack, so the app is always the one that gives
# up first: an 80 MB screen recording cut off mid-body reaches it as a network
# failure, which it queues and retries into the same wall.
# REQUEST_TIMEOUT_MS=240000
# HEADERS_TIMEOUT_MS=15000

# Clips one caller may have analysed per day. 0 (default) turns the cap off.
# Counted against the connecting address, which the caller cannot choose.
# Counts live in memory and reset when the process restarts.
# DAILY_CLIP_LIMIT=0

# How many proxies of your own stand in front of this server ("true" means one).
# Only set it when they really are yours: the caller's address is then taken
# from X-Forwarded-For, counting that many entries from the RIGHT. Proxies
# append the address they saw, so the rightmost entries are the ones your
# proxies wrote and the leftmost is whatever the caller typed — reading that
# would let anyone reset their own quota. A hop with a port on it
# (203.0.113.9:54321, [2001:db8::1]:443 — Azure writes these) is understood; a
# hop that is not an address at all shares one bucket with every other caller,
# and the server says so once in the log. A container published on 127.0.0.1
# with a proxy on the host is still one proxy: leave this unset there and every
# client arrives as the Docker bridge gateway, sharing one bucket.
# TRUST_PROXY=1

# Browser origin allowed to call this server. Unset (the default) sends no CORS
# headers at all, which is right for the mobile app: it is not a browser. Name
# one origin: "*" is refused at startup, because it would hand every page on
# the internet this server's Claude budget.
# CORS_ORIGIN=https://example.com

# Limits on decoding attacker-supplied video. MAX_PIXELS and MAX_DURATION_SECONDS
# are checked against what the probe read, so they bound extraction; what bounds
# the probe itself is MAX_STREAMS (how many decoders ffmpeg may open at all —
# every stream counts, not only video) and PROBE_MEMORY_MB (address space one
# probe may take; 0 turns it off, and a probe that will not fit is refused as
# unreadable).
# FFMPEG_TIMEOUT_MS=20000
# MAX_PIXELS=9437184
# MAX_STREAMS=8
# PROBE_MEMORY_MB=512
# MAX_DURATION_SECONDS=900
# MAX_SESSIONS=500
# RETRY_WAIT_MS=45000

# Optional cheaper model for a first pass; the main model only re-reads the same
# evidence when that answer is not confident. Measure accuracy before enabling.
# FIRST_PASS_MODEL=claude-sonnet-5

# Optional speech-to-text so dialogue can be searched.
#   none         – (default) rely on frames + on-screen text only
#   whisper-http – POST audio to an OpenAI-compatible /v1/audio/transcriptions endpoint
#                  (works with self-hosted faster-whisper / whisper.cpp servers too)
# STT_URL has no default and is required by whisper-http: the audio is a
# recording of your room, so where it is sent is yours to name rather than the
# server's to guess. The example below is a whisper.cpp server on this machine;
# a hosted API works too, and then the audio leaves it.
# STT_PROVIDER=whisper-http
# STT_URL=http://127.0.0.1:8080/v1/audio/transcriptions
# STT_API_KEY=
# STT_MODEL=whisper-1
# STT_TIMEOUT_MS=60000

# Optional YouTube Data API v3 key. Without it we still resolve links via oEmbed and
# Claude's web search; with it we can run a proper YouTube search as a fallback.
# YOUTUBE_API_KEY=

# Wikipedia edition for article lookups (en, de, fr, ...).
# WIKIPEDIA_LANG=en

# Optional TMDB v3 key. Adds "where to watch" (streaming / rent / buy in the
# user's country) and a cast list to film and TV results. Free from
# https://www.themoviedb.org/settings/api
# TMDB_API_KEY=

# Country used for watch providers when the app does not send one.
# WATCH_REGION=US

# Explicit ffmpeg binary. Defaults to `ffmpeg` on PATH, then the ffmpeg-static package.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Where uploaded clips are staged. Cleaned up after every request.
# TMP_DIR=./tmp
