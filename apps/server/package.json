{
  "name": "@tvsham/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TVsham recognition server: turns a short video clip into a Wikipedia article or YouTube link.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "eval": "tsx src/eval/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@hono/node-server": "^1.14.0",
    "@tvsham/shared": "*",
    "ffmpeg-static": "^5.2.0",
    "hono": "^4.13.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
