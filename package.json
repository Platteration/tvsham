{
  "name": "tvsham",
  "private": true,
  "version": "0.1.0",
  "description": "Shazam for video: point your phone at a TV or share a screen recording, get the Wikipedia article or YouTube link.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "server": "npm run dev --workspace apps/server",
    "mobile": "npm run start --workspace apps/mobile",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces",
    "test:conventions": "node --test test/conventions.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:conventions",
    "test:e2e": "npm run test:e2e --workspace apps/mobile",
    "test:all": "npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  }
}
